generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int           @id @default(autoincrement())
  email     String        @unique
  password  String
  name      String?
  avatarUrl String?
  onboardingSeen Boolean   @default(false)
  createdAt DateTime      @default(now())
  messages  Message[]
  rooms     RoomMember[]  // <-- New: rooms the user belongs to
}

model Room {
  id        Int           @id @default(autoincrement())
  name      String?
  type      RoomType      @default(GROUP)
  createdAt DateTime      @default(now())

  messages  Message[]
  members   RoomMember[]  // <-- New: who belongs to this room
}

model RoomMember {
  id      Int   @id @default(autoincrement())

  userId  Int
  user    User  @relation(fields: [userId], references: [id])

  roomId  Int
  room    Room  @relation(fields: [roomId], references: [id])

  @@unique([userId, roomId])
}

model Message {
  id        Int       @id @default(autoincrement())
  text      String
  createdAt DateTime  @default(now())

  sender    User      @relation(fields: [senderId], references: [id])
  senderId  Int

  room      Room      @relation(fields: [roomId], references: [id])
  roomId    Int
}

enum RoomType {
  GROUP
  DM
}
